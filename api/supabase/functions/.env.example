# Copia este archivo como .env y reemplaza los valores localmente.
# No incluyas el archivo .env real en Git.
WEBRISK_API_KEY=replace-with-google-web-risk-key
QR_CACHE_HMAC_SECRET=replace-with-a-random-secret-of-at-least-32-bytes
# Optional: personal Escudo QR notes (qr-site-notes). Leave the key empty to
# keep the feature off; the app then hides the notes card.
ATOMICMEMORY_API_URL=https://api.atomicstrata.ai
ATOMICMEMORY_API_KEY=
