{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://qhawix.invalid/contracts/release-manifest-1.0.0.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "versionName",
    "versionCode",
    "packageId",
    "minSdk",
    "abis",
    "apkUrl",
    "sha256",
    "bytes",
    "signingCertificateSha256",
    "publishedAt",
    "notesUrl"
  ],
  "properties": {
    "schemaVersion": { "const": "1.0.0" },
    "versionName": { "type": "string", "minLength": 1 },
    "versionCode": { "type": "integer", "minimum": 1 },
    "packageId": { "type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_]*(\\.[A-Za-z][A-Za-z0-9_]*)+$" },
    "minSdk": { "type": "integer", "minimum": 24 },
    "abis": { "type": "array", "minItems": 1, "items": { "enum": ["arm64-v8a", "armeabi-v7a", "x86_64"] }, "uniqueItems": true },
    "apkUrl": { "type": "string", "format": "uri", "pattern": "^https://" },
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "bytes": { "type": "integer", "minimum": 1 },
    "signingCertificateSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "publishedAt": { "type": "string", "format": "date-time" },
    "notesUrl": { "type": "string", "format": "uri", "pattern": "^https://" }
  }
}
